# Perfetto Configuration for ANVIL Android App Profiling
# Records CPU scheduling, GPU SurfaceFlinger frame timelines,
# Jetpack Compose runtime recompositions, and custom app trace slices.

buffers: {
    size_kb: 131072
    fill_policy: RING_BUFFER
}

buffers: {
    size_kb: 16384
    fill_policy: RING_BUFFER
}

data_sources: {
    config {
        name: "linux.ftrace"
        ftrace_config {
            ftrace_events: "sched/sched_switch"
            ftrace_events: "sched/sched_waking"
            ftrace_events: "sched/sched_blocked_reason"
            ftrace_events: "power/cpu_frequency"
            ftrace_events: "power/cpu_idle"
            ftrace_events: "power/gpu_frequency"
            ftrace_events: "task/task_newtask"
            ftrace_events: "task/task_rename"
            atrace_categories: "am"
            atrace_categories: "dalvik"
            atrace_categories: "binder_driver"
            atrace_categories: "view"
            atrace_categories: "wm"
            atrace_categories: "input"
            atrace_categories: "res"
            atrace_categories: "gfx"
            atrace_categories: "ss"
            atrace_apps: "com.james.anvil"
        }
    }
}

data_sources: {
    config {
        name: "android.surfaceflinger.frametimeline"
    }
}

data_sources: {
    config {
        name: "android.surfaceflinger.frame"
    }
}

data_sources: {
    config {
        name: "track_event"
        track_event_config {
            disabled_categories: "*"
            enabled_categories: "com.james.anvil"
            enabled_categories: "androidx.tracing"
            enabled_categories: "androidx.compose.runtime"
            enabled_categories: "rendering"
            enabled_categories: "workmanager"
            enabled_categories: "database"
        }
    }
}

data_sources: {
    config {
        name: "android.power"
        android_power_config {
            battery_poll_ms: 250
            collect_power_rails: true
            collect_energy_breakdown: true
        }
    }
}

duration_ms: 10000
write_into_file: true
file_write_period_ms: 1000
max_file_size_bytes: 150000000
